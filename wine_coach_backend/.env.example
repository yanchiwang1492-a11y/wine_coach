# ============================================================
# WineCoach 后端配置模板
# 使用方式：复制本文件为 .env，再填入真实值（.env 不要提交到 git）
# 规范：敏感值（密码/密钥/API Key）一律留空或占位，非敏感默认值保留
# ============================================================

# ========== 服务配置 ==========
HOST=localhost
PORT=8000

# ========== MySQL（wine_coach 库：user/question_library/practice_session/practice_message） ==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wine_coach
DB_CHARSET=utf8mb4

# ========== PostgreSQL（L2 摘要记忆：session_summary 表） ==========
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=wine_coach_memory
# LangGraph PostgresSaver checkpointer 用（URI 格式）
POSTGRES_URL=postgresql://postgres:你的pg密码@localhost:5432/wine_coach_memory

# ========== Redis（L1 窗口记忆 + L4 用户画像 + JWT 黑名单） ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== Chroma（L3 长期记忆） ==========
CHROMA_PATH=./db_chroma
CHROMA_COLLECTION=long_term_memory

# ========== JWT 认证 ==========
# 密钥：JWT 签名与验签用，务必修改。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
# token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=300

# ========== SMTP（发送评估报告邮件） ==========
EMAIL_SENDER=
EMAIL_PASSWORD=
SMTP_HOST=smtp.qq.com
SMTP_PORT=587

# ========== Vosk 语音模型（必填，否则语音功能不可用） ==========
# Windows 示例：
# VOSK_PATH=C:\path\to\vosk-model-cn-0.22
# Linux/Mac 示例：
# VOSK_PATH=/home/user/models/vosk-model-cn-0.22
VOSK_PATH=

# ========== 线上大模型（dashscope） ==========
DASHSCOPE_API_KEY=
MODEL_ONLINE_NAME=qwen-plus
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ========== 本地大模型（ollama 兜底） ==========
MODEL_LOCAL_NAME=qwen2.5:7b
LOCAL_URL=http://localhost:11434/v1
